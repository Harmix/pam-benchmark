FROM node:18-bullseye

# Install all dependencies in one layer
RUN apt-get update && apt-get install -y \
    git curl wget \
    build-essential zlib1g-dev libncurses5-dev libgdbm-dev \
    libnss3-dev libssl-dev libreadline-dev libffi-dev \
    libsqlite3-dev libbz2-dev \
    && wget -q https://www.python.org/ftp/python/3.11.9/Python-3.11.9.tgz \
    && tar -xf Python-3.11.9.tgz \
    && cd Python-3.11.9 \
    && ./configure --enable-optimizations --quiet \
    && make -j$(nproc) > /dev/null 2>&1 \
    && make altinstall > /dev/null 2>&1 \
    && cd .. && rm -rf Python-3.11.9* \
    && wget -q https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O /usr/bin/yq \
    && chmod +x /usr/bin/yq \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/local/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/pip3 pip3 /usr/local/bin/pip3.11 1

# Install Claude Code
RUN npm install -g @anthropic-ai/claude-code

# Setup workspace
RUN mkdir -p /workspace /mcp-servers
WORKDIR /workspace

# Copy and install Python dependencies
COPY requirements.txt /mcp-servers/
RUN python3 -m pip install -q -r /mcp-servers/requirements.txt

# Copy application files
COPY data_loader.py slack_mcp_server.py linear_mcp_server.py /mcp-servers/
COPY test_configs ./test_configs
COPY test_event_histories ./test_event_histories
COPY setup_and_run.sh .
RUN chmod +x setup_and_run.sh

CMD ["/bin/bash"]