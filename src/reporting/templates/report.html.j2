<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ dataset|title }} report — {{ exp_name }}</title>
<style>
:root {
  --primary: #2563eb;
  --success: #16a34a;
  --warning: #ca8a04;
  --error:   #dc2626;
  --bg:      #f8fafc;
  --card:    #ffffff;
  --text:    #1e293b;
  --muted:   #64748b;
  --border:  #e2e8f0;
}
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
       background: var(--bg); color: var(--text); padding: 2rem; line-height: 1.5; }
.container { max-width: 1280px; margin: 0 auto; }
.header { background: linear-gradient(135deg, var(--primary), #1d4ed8); color: white;
          padding: 2rem; border-radius: 12px; margin-bottom: 2rem; }
.header h1 { font-size: 1.875rem; margin-bottom: .5rem; }
.header-meta { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: .75rem;
               font-size: .9rem; opacity: .92; }
.section { background: var(--card); padding: 1.5rem; border-radius: 12px;
           box-shadow: 0 1px 3px rgba(0,0,0,.08); margin-bottom: 1.5rem; }
.section h2 { font-size: 1.25rem; margin-bottom: 1rem; color: var(--text); }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
         gap: 1rem; margin-bottom: 1rem; }
.card { background: var(--card); padding: 1.25rem; border-radius: 10px;
        box-shadow: 0 1px 2px rgba(0,0,0,.06); text-align: center; }
.card-value { font-size: 1.875rem; font-weight: 700; color: var(--primary); }
.card-value.good { color: var(--success); }
.card-value.warn { color: var(--warning); }
.card-value.bad  { color: var(--error); }
.card-label { font-size: .85rem; color: var(--muted); margin-top: .25rem; }
table { width: 100%; border-collapse: collapse; font-size: .9rem; }
th { background: #f1f5f9; padding: .65rem .75rem; text-align: left;
     font-weight: 600; color: var(--text); border-bottom: 2px solid var(--border); }
td { padding: .65rem .75rem; border-bottom: 1px solid var(--border); }
tr:hover td { background: #f8fafc; }
.badge { display: inline-block; padding: .15rem .55rem; border-radius: 999px;
         font-size: .8rem; font-weight: 600; }
.badge.good { background: #dcfce7; color: var(--success); }
.badge.warn { background: #fef9c3; color: var(--warning); }
.badge.bad  { background: #fee2e2; color: var(--error); }
.error-card { background: #fef2f2; border-left: 3px solid var(--error); padding: 1rem;
              margin-bottom: 1rem; border-radius: 8px; }
.error-card h4 { font-size: .95rem; margin-bottom: .5rem; }
.error-row { margin: .35rem 0; font-size: .88rem; }
.error-row b { color: var(--muted); }
.error-row .ans { font-family: ui-monospace, 'SF Mono', Menlo, monospace; }
details summary { cursor: pointer; padding: .5rem 0; font-weight: 600; color: var(--muted); }
.muted { color: var(--muted); font-size: .85rem; }
</style>
</head>
<body>
<div class="container">

  <div class="header">
    <h1>{{ dataset|title }} report — {{ exp_name }}</h1>
    <div class="header-meta">
      <span><b>Generated:</b> {{ generated_at }}</span>
      <span><b>Dataset:</b> {{ dataset_name }}</span>
      <span><b>Baselines:</b> {{ baselines|join(', ') }}</span>
      <span><b>Seeds:</b> {{ seeds|join(', ') }}</span>
      <span><b>Judge:</b> {{ judge_models|join(', ') }}</span>
      <span><b>Samples:</b> {{ sample_count }}</span>
    </div>
  </div>

  <div class="section">
    <h2>Headline</h2>
    <div class="cards">
      <div class="card">
        <div class="card-value {{ headline.judge_class }}">{{ headline.judge_accuracy_pct }}%</div>
        <div class="card-label">LLM-judge accuracy (primary)</div>
      </div>
      <div class="card">
        <div class="card-value">{{ headline.judge_correct }}/{{ headline.judge_total }}</div>
        <div class="card-label">LLM-judge correct</div>
      </div>
      <div class="card">
        <div class="card-value {{ headline.f1_class }}">{{ headline.f1_pct }}%</div>
        <div class="card-label">F1 accuracy (weighted)</div>
      </div>
      <div class="card">
        <div class="card-value">{{ headline.total_questions }}</div>
        <div class="card-label">Total questions</div>
      </div>
      <div class="card">
        <div class="card-value">${{ '%.4f'|format(headline.total_cost_usd) }}</div>
        <div class="card-label">Total cost (USD est.)</div>
      </div>
      <div class="card">
        <div class="card-value">{{ '%.0f'|format(headline.avg_latency_ms) }} ms</div>
        <div class="card-label">Avg latency / question</div>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>Per-category breakdown</h2>
    <table>
      <thead><tr>
        <th>Category</th><th>Questions</th>
        <th>F1 accuracy</th><th>LLM-judge correct</th><th>LLM-judge %</th>
      </tr></thead>
      <tbody>
      {% for row in per_category %}
        <tr>
          <td>{{ row.name }}</td>
          <td>{{ row.count }}</td>
          <td>{{ '%.1f'|format(row.f1*100) }}%</td>
          <td>{{ row.judge_correct }}/{{ row.count }}</td>
          <td><span class="badge {{ row.judge_class }}">{{ '%.1f'|format(row.judge_pct) }}%</span></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="section">
    <h2>Per-sample results</h2>
    <table>
      <thead><tr>
        <th>Baseline</th><th>Seed</th><th>Sample</th><th>Q</th>
        <th>F1</th><th>Judge</th><th>Cost</th><th>p50 / p95 latency</th><th>Wall-clock</th>
      </tr></thead>
      <tbody>
      {% for row in per_sample %}
        <tr>
          <td>{{ row.baseline }}</td>
          <td>{{ row.seed }}</td>
          <td>{{ row.sample_id }}</td>
          <td>{{ row.total_questions }}</td>
          <td>{{ '%.1f'|format(row.overall_accuracy*100) }}%</td>
          <td><span class="badge {{ row.judge_class }}">{{ '%.1f'|format(row.judge_accuracy*100) }}%</span></td>
          <td>${{ '%.4f'|format(row.total_cost_usd) }}</td>
          <td>{{ '%.0f'|format(row.p50_latency_ms) }} / {{ '%.0f'|format(row.p95_latency_ms) }} ms</td>
          <td>{{ '%.1f'|format(row.execution_time_seconds) }} s</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="section">
    <h2>Incorrect responses ({{ incorrect|length }})</h2>
    <p class="muted">Filtered to records where the LLM judge marked the answer incorrect.</p>
    {% if incorrect %}
      {% for r in incorrect %}
        <div class="error-card">
          <h4>Sample {{ r.sample_id }} · Q{{ r.question_num }} · {{ r.category_name }}
              {% if r.is_adversarial %}<span class="badge warn">adversarial</span>{% endif %}
              <span class="badge bad">F1 {{ '%.2f'|format(r.f1_score) }}</span>
          </h4>
          <div class="error-row"><b>Question:</b> {{ r.question }}</div>
          <div class="error-row"><b>Expected:</b> <span class="ans">{{ r.expected_answer }}</span></div>
          <div class="error-row"><b>Model:</b> <span class="ans">{{ r.model_answer }}</span></div>
          {% if r.evidence %}
            <div class="error-row"><b>Evidence:</b> {{ r.evidence|join(', ') }}</div>
          {% endif %}
          <div class="error-row"><b>Judge reasoning:</b> {{ r.judge_reasoning }}</div>
        </div>
      {% endfor %}
    {% else %}
      <p class="muted">No incorrect responses.</p>
    {% endif %}
  </div>

</div>
</body>
</html>
